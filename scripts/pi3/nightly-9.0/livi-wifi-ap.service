[Unit]
Description=LIVI wireless projection AP (early boot)
After=network-pre.target
Wants=network-pre.target
ConditionPathExists=/home/livilite/.config/LIVI/driver/livi-helperd

[Service]
Type=simple
Environment=SUDO_USER=livilite
ExecStart=/home/livilite/.config/LIVI/driver/livi-helperd --wifi-ap
ExecStop=/home/livilite/.config/LIVI/driver/livi-helperd --wifi-ap-teardown
TimeoutStopSec=8
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
